{
  "name": "dsh-liketavern",
  "version": "0.5.11",
  "description": "Tavern mode for dsh web — SillyTavern character cards, prompt presets, lorebooks, personas and regex on the dsh agent runtime.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Amakurai/dsh-liketavern.git"
  },
  "type": "module",
  "main": "lib/index.js",
  "bin": {
    "dsh-tavern-doctor": "./lib/doctor.js",
    "dsh-tavern-backup": "./lib/backup.js"
  },
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./agent": {
      "types": "./lib/agent.d.ts",
      "default": "./lib/agent.js"
    },
    "./client": {
      "types": "./lib/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./doctor": {
      "types": "./lib/doctor.d.ts",
      "default": "./lib/doctor.js"
    },
    "./backup": {
      "types": "./lib/backup.d.ts",
      "default": "./lib/backup.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "presets",
    "README.md",
    "README.en.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=24",
    "dsh": "*"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  },
  "scripts": {
    "build": "node scripts/build-checkpoint-engine.mjs && node scripts/build-template-vendor.mjs && node scripts/build-card-vendor.mjs && tsc -p tsconfig.json && node scripts/build-client.mjs",
    "test": "vitest run",
    "doctor": "node lib/doctor.js",
    "doctor:check": "node scripts/verify-doctor.mjs",
    "backup": "node lib/backup.js",
    "backup:check": "node scripts/verify-backup.mjs",
    "package:check": "node scripts/verify-package.mjs --dry-run",
    "host:check": "node scripts/verify-host-alignment.mjs && node scripts/verify-dependencies.mjs",
    "release": "node scripts/release.mjs",
    "release:notes": "node scripts/release-notes.mjs",
    "prepack": "npm run build",
    "dev": "dsh web --patch ./cordis.patch.yml"
  },
  "dependencies": {
    "@faker-js/faker": "10.6.0",
    "ejs": "6.0.1",
    "jquery": "3.7.1",
    "jsonrepair": "3.15.0",
